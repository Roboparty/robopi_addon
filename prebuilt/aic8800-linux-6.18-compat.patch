From: RoboParty <roboparty@local>
Subject: [PATCH] aic8800: Linux 6.18 API compatibility

Adapt UGREEN AX300 / AIC8800 vendor driver sources for
Linux 6.18 (wakeup_source, timer, cfg80211 link_id, radio_idx).

Apply on top of UGREEN_AIC-AX300_LinuxDriver_V1.6:

  patch -p1 < prebuilt/aic8800-linux-6.18-compat.patch

--- a/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_wakelock.c
+++ b/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_wakelock.c
@@ -11,18 +11,14 @@
 
 struct wakeup_source *rwnx_wakeup_init(const char *name)
 {
-	struct wakeup_source *ws;
-	ws = wakeup_source_create(name);
-	wakeup_source_add(ws);
-	return ws;
+	return wakeup_source_register(NULL, name);
 }
 
 void rwnx_wakeup_deinit(struct wakeup_source *ws)
 {
 	if (ws && ws->active)
 		__pm_relax(ws);
-	wakeup_source_remove(ws);
-	wakeup_source_destroy(ws);
+	wakeup_source_unregister(ws);
 }
 
 struct wakeup_source *rwnx_wakeup_register(struct device *dev, const char *name)
--- a/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_compat.h
+++ b/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_compat.h
@@ -430,4 +430,22 @@
 typedef __s64 time64_t;
 #endif
 
+
+/* Linux 6.1+ API: from_timer removed, timer_container_of used instead */
+#include <linux/timer.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+#ifndef from_timer
+#define from_timer(var, callback_timer, timer_fieldname) \
+	timer_container_of(var, callback_timer, timer_fieldname)
+#endif
+#endif
+/* Linux 6.15+: del_timer/del_timer_sync renamed to timer_delete/timer_delete_sync */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 15, 0)
+#ifndef del_timer
+#define del_timer(timer) timer_delete(timer)
+#endif
+#ifndef del_timer_sync
+#define del_timer_sync(timer) timer_delete_sync(timer)
+#endif
+#endif
 #endif /* _RWNX_COMPAT_H_ */
--- a/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
+++ b/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_rx.c
@@ -2186,7 +2186,11 @@
 #if LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0)
 	defrag_ctrl = (struct defrag_ctrl_info *)data;
 #else
+	#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 2, 0)
+	defrag_ctrl = timer_container_of(defrag_ctrl, t, defrag_timer);
+#else
 	defrag_ctrl = from_timer(defrag_ctrl, t, defrag_timer);
+#endif
 #endif
 
 	printk("%s:%p\r\n", __func__, defrag_ctrl);
@@ -2352,7 +2356,11 @@
         hdr = (struct ieee80211_hdr *)(skb->data + msdu_offset);
         rwnx_vif = rwnx_rx_get_vif(rwnx_hw, hw_rxhdr->flags_vif_idx);
         if (rwnx_vif) {
+            #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 0, 0)
+            cfg80211_rx_spurious_frame(rwnx_vif->ndev, hdr->addr2, -1, GFP_ATOMIC);
+#else
             cfg80211_rx_spurious_frame(rwnx_vif->ndev, hdr->addr2, GFP_ATOMIC);
+#endif
         }
         goto end;
     }
@@ -2598,8 +2606,13 @@
                 }
 
                 if (hw_rxhdr->flags_is_4addr && !rwnx_vif->use_4addr) {
+                    #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 0, 0)
+                    cfg80211_rx_unexpected_4addr_frame(rwnx_vif->ndev,
+                                                       sta->mac_addr, -1, GFP_ATOMIC);
+#else
                     cfg80211_rx_unexpected_4addr_frame(rwnx_vif->ndev,
                                                        sta->mac_addr, GFP_ATOMIC);
+#endif
                 }
             }
 
--- a/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ b/aic8800_linux_drvier/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -4265,7 +4265,11 @@
  *	have changed. The actual parameter values are available in
  *	struct wiphy. If returning an error, no value should be changed.
  */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0)
+static int rwnx_cfg80211_set_wiphy_params(struct wiphy *wiphy, int radio_idx, u32 changed)
+#else
 static int rwnx_cfg80211_set_wiphy_params(struct wiphy *wiphy, u32 changed)
+#endif
 {
     return 0;
 }
@@ -4281,6 +4285,9 @@
 static int rwnx_cfg80211_set_tx_power(struct wiphy *wiphy,
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 8, 0)
  struct wireless_dev *wdev,
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 14, 0)
+ int radio_idx,
 #endif
                                       enum nl80211_tx_power_setting type, int mbm)
 {
