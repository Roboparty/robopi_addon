#!/bin/sh
set -e

DKMS_NAME=roboparty-ws2812
DKMS_VERSION=1.5.0

if [ "$1" = configure ]; then
    if command -v dkms >/dev/null 2>&1; then
        dkms add -m "$DKMS_NAME" -v "$DKMS_VERSION" || true
        if ! dkms build -m "$DKMS_NAME" -v "$DKMS_VERSION"; then
            echo "robopi-addon: kernel module build failed (missing linux-headers?)" >&2
            echo "robopi-addon: install linux-headers and run 'dkms autoinstall'." >&2
        fi
        dkms install -m "$DKMS_NAME" -v "$DKMS_VERSION" || true
    fi
fi

#DEBHELPER#
exit 0
