#!/bin/sh
set -e

is_chroot()
{
    if command -v systemd-detect-virt >/dev/null 2>&1; then
        systemd-detect-virt --quiet --chroot
        return $?
    fi

    [ "$(stat -c %d:%i / 2>/dev/null)" != "$(stat -c %d:%i /proc/1/root/. 2>/dev/null)" ]
}

if [ "$1" = configure ]; then
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable robopi-usb-wifi.service 2>/dev/null || true
    systemctl enable robopi-wifi-autoselect.service 2>/dev/null || true
    systemctl disable robopi-ethernet-mac.service 2>/dev/null || true
    systemctl enable robopi-ethernet-static.service 2>/dev/null || true
    systemctl disable robopi-hw-test.service robopi-sig-key.service 2>/dev/null || true
    systemctl enable robopi-bms-gpio.service 2>/dev/null || true
    systemctl enable robopi-fan.service 2>/dev/null || true
    systemctl enable robopi-ws2812-white.service 2>/dev/null || true
    systemctl enable robopi-uart-bridge.service 2>/dev/null || true

    if ! is_chroot; then
        # Persist package files and enable/disable links before GPIO transitions.
        # The target image uses ext4 commit=600; battery removal can lose cached writes.
        sync
        # Do not fail the entire addon installation if USB hardware initialization
        # fails; keep the service failure and logs available for diagnosis.
        systemctl restart robopi-usb-wifi.service || echo "robopi-addon: USB Wi-Fi initialization failed; inspect journalctl -u robopi-usb-wifi" >&2
        udevadm control --reload-rules || true
        echo "robopi-addon: USB Wi-Fi naming rule installed; reboot or replug USB Wi-Fi to apply wlan1."
        # Default onboard wlan0 to unmanaged when no selection exists yet.
        nm_live=/etc/NetworkManager/conf.d/90-robopi-wifi-select.conf
        if [ ! -f /etc/roboparty/wifi-interface ] && [ ! -f "$nm_live" ]; then
            install -d /etc/NetworkManager/conf.d
            printf '%s\n' \
                '[device-robopi-wifi-select]' \
                'match-device=interface-name:wlan0' \
                'managed=0' > "$nm_live"
            chmod 0644 "$nm_live"
            nmcli general reload 2>/dev/null || true
            echo "robopi-addon: onboard wlan0 unmanaged by default; select with robopi-wifi-select usb|onboard wlan0"
        fi
        # Blacklist ships in the package; unload a live onboard radio so wlan0
        # disappears without waiting for the next reboot. USB Wi-Fi and BT stay.
        if lsmod | grep -q '^brcmfmac'; then
            modprobe -r brcmfmac_wcc 2>/dev/null || true
            modprobe -r brcmfmac 2>/dev/null || true
            echo "robopi-addon: onboard Wi-Fi driver unloaded; remove blacklist and reboot to restore wlan0"
        fi
        # Also scan already plugged-in adapters; reloading udev rules alone does
        # not activate SYSTEMD_WANTS on a device that is already active.
        systemctl restart --no-block robopi-wifi-autoselect.service || true
        systemctl stop robopi-hw-test.service robopi-sig-key.service
        systemctl restart robopi-bms-gpio.service || echo "robopi-addon: BMS GPIO service failed; check journalctl -u robopi-bms-gpio" >&2
        systemctl restart robopi-fan.service 2>/dev/null || true
        systemctl restart robopi-ws2812-white.service 2>/dev/null || true
        systemctl restart robopi-uart-bridge.service || echo "robopi-addon: UART bridge failed; inspect journalctl -u robopi-uart-bridge" >&2
    fi
fi

#DEBHELPER#
exit 0
