#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
    # Do not-load removed hotplug rules on running systems as well.
    udevadm control --reload-rules 2>/dev/null || true
    # Package-owned blacklist is gone; bring onboard Wi-Fi back without reboot.
    modprobe brcmutil 2>/dev/null || true
    modprobe brcmfmac 2>/dev/null || true
fi

#DEBHELPER#
exit 0
