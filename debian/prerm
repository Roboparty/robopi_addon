#!/bin/sh
set -e

DKMS_NAME=roboparty-ws2812
DKMS_VERSION=1.5.0

if [ "$1" = remove ] || [ "$1" = deconfigure ]; then
    modprobe -r roboparty_ws2812 2>/dev/null || true
    if command -v dkms >/dev/null 2>&1; then
        dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" --all || true
    fi
fi

#DEBHELPER#
exit 0
