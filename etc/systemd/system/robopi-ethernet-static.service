[Unit]
Description=Apply RoboPi static Ethernet uplink to the Windows host
Documentation=https://github.com/Roboparty/robopi_addon
Wants=NetworkManager.service
After=systemd-udevd.service NetworkManager.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/robopi-ethernet-static
ExecStart=/opt/roboparty/bin/robopi-ethernet-static apply
RemainAfterExit=yes
Restart=on-failure
RestartSec=3
# Covers the interface wait window plus retries.
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
