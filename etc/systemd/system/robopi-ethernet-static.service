[Unit]
Description=RoboPi 有线连接 1 开机静态地址
Wants=NetworkManager.service
After=NetworkManager.service
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=oneshot
EnvironmentFile=-/etc/roboos/env
ExecStart=/bin/bash -lc 'exec "$${ROBOOS_PREFIX:-/opt/roboparty}/bin/robopi-ethernet-static"'
RemainAfterExit=yes
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
