[Unit]
Description=RoboPi WS2812 boot blue light
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/roboos/env
ExecStart=/bin/bash -lc 'exec "$${ROBOOS_PREFIX:-/opt/roboparty}/bin/robopi-ws2812" solid 30 30 30'
ExecStop=/bin/bash -lc 'exec "$${ROBOOS_PREFIX:-/opt/roboparty}/bin/robopi-ws2812" off'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
