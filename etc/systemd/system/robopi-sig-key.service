[Unit]
Description=RoboPi SIG rising-edge LED trigger
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=-/etc/roboos/env
ExecStart=/bin/bash -lc 'exec "$${ROBOOS_PREFIX:-/opt/roboparty}/bin/robopi-sig-key" --sig-chip /dev/gpiochip1 --sig 29 --led-chip /dev/gpiochip0 --led 18'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
