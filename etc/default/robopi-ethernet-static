# Static Ethernet uplink configuration (board <-> Windows direct cable).
# Used by robopi-ethernet-static.service. After editing, apply with:
#   sudo systemctl restart robopi-ethernet-static.service

# Board-side interface cabled to the Windows PC
ETHERNET_INTERFACE=enP4p65s0

# Static board address in CIDR form. This service owns the interface:
# IPv4 addresses are flushed before this one is added.
ETHERNET_IP=192.168.13.1/24

# Windows-side NIC address; used as the default gateway. The board's
# internet traffic exits through the Windows host.
ETHERNET_GATEWAY=192.168.13.10

# DNS servers. Applied via resolvectl when systemd-resolved is active,
# otherwise written to /etc/resolv.conf as a fallback. ETHERNET_DNS2 may
# be left empty.
ETHERNET_DNS1=223.5.5.5
ETHERNET_DNS2=8.8.8.8

# Seconds to wait for the interface to appear at boot
ETHERNET_WAIT_SECONDS=30
